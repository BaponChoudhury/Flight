# Copy to .env.local for local dev. Never commit real values.

# Ignav (required for searches) — https://ignav.com dashboard
IGNAV_API_KEY=

# Aviasales / Travelpayouts (optional: more fares, bag details, refundable filter)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Supabase (optional in Phase 1; without it an in-memory store is used)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: password-protect the whole app (HTTP basic auth, any username)
APP_PASSWORD=

# Phase 3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin-only data (hidden-market fare requests, config edits)
ADMIN_PASSWORD=
